		"commands": [
			{
				"command": "omniCopilot.testConnection",
				"title": "OmniCopilot: Test Connection"
			},
			{
				"command": "omniCopilot.setContextLength",
				"title": "OmniCopilot: Set Max Input Context Length"
			}
		],
		"configuration": {
			"title": "OmniCopilot",
			"properties": {
				"omniCopilot.contextLength": {
					"type": "string",
					"default": "default",
					"enum": [
						"default",
						"4k",
						"8k",
						"16k",
						"32k",
						"64k",
						"128k",
						"256k",
						"512k",
						"1m",
						"custom"
					],
					"enumDescriptions": [
						"Use each model's default context length",
						"Limit to 4,096 tokens",
						"Limit to 8,192 tokens",
						"Limit to 16,384 tokens",
						"Limit to 32,768 tokens",
						"Limit to 65,536 tokens",
						"Limit to 131,072 tokens",
						"Limit to 262,144 tokens",
						"Limit to 524,288 tokens",
						"Limit to 1,048,576 tokens",
						"Use a custom context length (set below)"
					],
					"description": "Maximum input context length sent to models — output tokens are not affected"
				},
				"omniCopilot.customContextLength": {
					"type": "number",
					"default": 131072,
					"minimum": 1024,
					"maximum": 2097152,
					"description": "Custom maximum input context length (used when Input Context Length is set to Custom) — output tokens are not affected"
				},
				"omniCopilot.enableVision": {
					"type": "boolean",
					"default": true,
					"description": "Enable vision/image input for models that support it"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"test": "npm run compile && node --test tests/*.test.cjs",
		"watch": "tsc -watch -p ./",
		"package": "npx @vscode/vsce package",
		"publish": "npx @vscode/vsce publish"
	},
	"devDependencies": {
		"@types/node": "20.19.29",
		"@types/vscode": "1.108.0",
		"typescript": "5.9.3"
	}
